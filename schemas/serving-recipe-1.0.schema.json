{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://santho090.github.io/inference-capacity-contract/schemas/serving-recipe-1.0.schema.json",
  "title": "Normalized Serving Recipe 1.0",
  "type": "object",
  "required": ["schema_version", "recipe_id", "model", "host", "runtime", "topology", "llmd", "configured_groups", "evidence"],
  "properties": {
    "schema_version": {"const": "serving-recipe-1.0"},
    "recipe_id": {"type": "string", "minLength": 1},
    "model": {"$ref": "https://santho090.github.io/inference-capacity-contract/schemas/capacity-contract-2.0.schema.json#/$defs/model"},
    "host": {"$ref": "https://santho090.github.io/inference-capacity-contract/schemas/capacity-contract-2.0.schema.json#/$defs/hardware"},
    "runtime": {"$ref": "https://santho090.github.io/inference-capacity-contract/schemas/capacity-contract-2.0.schema.json#/$defs/runtime"},
    "topology": {
      "type": "object",
      "required": ["tensor_parallel_size", "data_parallel_size", "expert_parallel_size", "physical_device_count", "independent_kv_ranks"],
      "properties": {
        "tensor_parallel_size": {"type": "integer", "minimum": 1},
        "data_parallel_size": {"type": "integer", "minimum": 1},
        "expert_parallel_size": {"type": "integer", "minimum": 1},
        "physical_device_count": {"type": "integer", "minimum": 1},
        "independent_kv_ranks": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "llmd": {
      "type": "object",
      "required": ["flow_control_token_limit", "max_concurrent_sequences", "kv_block_size_tokens", "output_ratio", "max_estimated_output_tokens", "precise_prefix_routing"],
      "properties": {
        "flow_control_token_limit": {"type": ["integer", "null"], "minimum": 1},
        "max_concurrent_sequences": {"type": ["integer", "null"], "minimum": 1},
        "kv_block_size_tokens": {"type": ["integer", "null"], "minimum": 1},
        "output_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "max_estimated_output_tokens": {"type": ["integer", "null"], "minimum": 1},
        "precise_prefix_routing": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "configured_groups": {"type": "integer", "minimum": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://santho090.github.io/inference-capacity-contract/schemas/capacity-contract-2.0.schema.json#/$defs/evidence"}
    }
  },
  "additionalProperties": false
}
