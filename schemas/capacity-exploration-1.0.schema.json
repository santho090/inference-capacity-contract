{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://santho090.github.io/inference-capacity-contract/schemas/capacity-exploration-1.0.schema.json",
  "title": "Capacity Exploration 1.0",
  "type": "object",
  "required": ["schema_version", "model", "context_tokens", "candidates", "assumptions"],
  "properties": {
    "schema_version": {"const": "capacity-exploration-1.0"},
    "model": {
      "$ref": "https://santho090.github.io/inference-capacity-contract/schemas/capacity-contract-2.0.schema.json#/$defs/model"
    },
    "context_tokens": {"type": "integer", "minimum": 1},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "assumptions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "resource_claim": {
      "type": "object",
      "required": [
        "serving_replicas", "required_instances", "serving_devices", "allocated_devices",
        "idle_devices", "devices_per_replica", "replicas_per_instance", "available_instances",
        "available_replicas", "fits_available_inventory"
      ],
      "properties": {
        "serving_replicas": {"type": "integer", "minimum": 1},
        "required_instances": {"type": "integer", "minimum": 1},
        "serving_devices": {"type": "integer", "minimum": 1},
        "allocated_devices": {"type": "integer", "minimum": 1},
        "idle_devices": {"type": "integer", "minimum": 0},
        "devices_per_replica": {"type": "integer", "minimum": 1},
        "replicas_per_instance": {"type": "integer", "minimum": 1},
        "available_instances": {"type": ["integer", "null"], "minimum": 0},
        "available_replicas": {"type": ["integer", "null"], "minimum": 0},
        "fits_available_inventory": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "rank", "candidate_id", "provider", "runtime_option", "status", "confidence",
        "context_tokens", "recipe_variant_fingerprint", "sequences_per_replica",
        "replicas_per_instance", "sequences_per_instance", "max_replicas",
        "max_sequences_at_context", "resource_claim", "hourly_cost", "cost_currency",
        "rejection_reasons", "warnings", "contract", "audit"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "provider": {"$ref": "https://santho090.github.io/inference-capacity-contract/schemas/provider-inventory-1.0.schema.json#/$defs/provider_instance"},
        "runtime_option": {"$ref": "https://santho090.github.io/inference-capacity-contract/schemas/runtime-inventory-1.0.schema.json#/$defs/runtime_option"},
        "status": {"enum": ["fits", "feasible", "incomplete", "insufficient-inventory", "rejected"]},
        "confidence": {"enum": ["analytical-memory", "analytical-memory+measured-performance"]},
        "context_tokens": {"type": "integer", "minimum": 1},
        "recipe_variant_fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "sequences_per_replica": {"type": "integer", "minimum": 0},
        "replicas_per_instance": {"type": "integer", "minimum": 0},
        "sequences_per_instance": {"type": "integer", "minimum": 0},
        "max_replicas": {"type": ["integer", "null"], "minimum": 0},
        "max_sequences_at_context": {"type": ["integer", "null"], "minimum": 0},
        "resource_claim": {"oneOf": [{"$ref": "#/$defs/resource_claim"}, {"type": "null"}]},
        "hourly_cost": {"type": ["number", "null"], "minimum": 0},
        "cost_currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "rejection_reasons": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "contract": {"oneOf": [{"$ref": "https://santho090.github.io/inference-capacity-contract/schemas/capacity-contract-2.0.schema.json"}, {"type": "null"}]},
        "audit": {"oneOf": [{"$ref": "https://santho090.github.io/inference-capacity-contract/schemas/recipe-audit-2.0.schema.json"}, {"type": "null"}]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
